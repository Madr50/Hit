def alert_system(message, level="info"):
    colors = {
        "info": CYAN,
        "success": GREEN,
        "warning": YELLOW,
        "error": RED,
        "hack": RED
    }
    color = colors.get(level, WHITE)
    if level == "hack":
        print(f"\n{color}{BOLD}{BLINK}🔥 {message} 🔥{RESET}")
        print('\a')
        time.sleep(0.3)
        print('\a')
        time.sleep(0.3)
        print('\a')
    elif level == "success":
        print(f"\n{color}{BOLD}✅ {message}{RESET}")
        print('\a')
    elif level == "warning":
        print(f"\n{color}{BOLD}⚠️ {message}{RESET}")
    elif level == "error":
        print(f"\n{color}{BOLD}❌ {message}{RESET}")
        print('\a')
    else:
        print(f"\n{color}{BOLD}ℹ️ {message}{RESET}")

