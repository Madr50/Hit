def load_stats():
    global stats
    if os.path.exists(STATS_FILE):
        try:
            with open(STATS_FILE, 'r') as f:
                stats = json.load(f)
        except:
            stats = {"total_attacks": 0, "total_reports": 0, "success_rate": 0, "last_attacks": []}

def save_stats():
    with open(STATS_FILE, 'w') as f:
        json.dump(stats, f, indent=4)

